# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/ephemeral/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
# Gradle's own build output lives under android/ and android/app/, not just
# the root /build/ Flutter itself uses — both must be excluded separately.
android/build/
android/app/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/.gradle/
android/local.properties

# iOS/macOS CocoaPods — regenerated by `pod install`, not source.
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/

# Claude Code: settings.local.json is per-machine/personal (permission
# allowlist etc.), unlike the shared launch.json — standard convention is
# to keep it untracked.
.claude/settings.local.json

# --- Secrets: never committed, regardless of the rules above ---
# Android app signing.
*.keystore
*.jks
android/key.properties
# Firebase / Google service configs, if this project ever adds them.
google-services.json
GoogleService-Info.plist
# Environment/secret files of any form.
.env
.env.*
*.env
